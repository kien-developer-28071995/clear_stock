# Frontend (Vite) environment. Only VITE_* variables are exposed to browser code.

# Public HTTPS URL the embedded app is served from (same value as APP_URL in backend/.env).
# The Vite dev server uses it so assets + HMR load through the tunnel inside the
# Shopify admin iframe. `make tunnel` rewrites it automatically.
APP_URL=https://example.trycloudflare.com
