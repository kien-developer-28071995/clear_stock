# Frontend (Vite) environment. Only VITE_* variables are exposed to browser code.

# Public HTTPS URL the app is opened at in dev (the tunnel; same value as APP_URL in backend/.env).
# The Vite dev server uses it so assets + HMR load through the tunnel inside the
# Shopify admin iframe. `make tunnel` rewrites it automatically.
APP_URL=https://example.trycloudflare.com

# Origin of the backend API, without a path (the app adds /api). Required for `npm run build`.
# Leave empty in dev: the tunnel hostname fronts both and the dev proxy routes /api to the backend.
VITE_API_URL=

# The app's client id (same value as SHOPIFY_API_KEY in backend/.env; public, App Bridge needs it).
# `make setup` and `make tunnel` copy it from backend/.env.
VITE_SHOPIFY_API_KEY=

# Name in the page title (same as SHOPIFY_APP_NAME in backend/.env).
VITE_APP_NAME=Clear Stock

# Where a visitor who opens the frontend outside Shopify is sent (the marketing website). Optional.
VITE_WEBSITE_URL=
