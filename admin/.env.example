APP_NAME="Clear Stock Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# The Clear Stock app's database (read-only: give this user SELECT only).
APPDB_HOST=mysql
APPDB_PORT=3306
APPDB_DATABASE=clear_stock
APPDB_USERNAME=clear_stock
APPDB_PASSWORD=

# Reports
REPORT_TIMEZONE=Asia/Ho_Chi_Minh
# Comma-separated IPs allowed to open the reports (empty = any IP; login is always required).
REPORT_ALLOWED_IPS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
