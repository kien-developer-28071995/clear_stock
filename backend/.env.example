APP_NAME="Clear Stock"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public HTTPS URL (tunnel in dev). `make tunnel` rewrites this (and frontend/.env) automatically.
APP_URL=https://example.trycloudflare.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logs go to stdout/stderr (docker compose logs)
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Shopify (Dev Dashboard > your app > Settings) ---
SHOPIFY_APP_NAME="Clear Stock"
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_inventory,read_locations,read_orders,read_all_orders
SHOPIFY_API_VERSION=2026-07

# --- Database (service "mysql" in docker compose) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=secret
# Used only by the mysql container (it reads this file too)
DB_ROOT_PASSWORD=root

# --- Redis (cache + queue + Horizon) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=app_cache_

# --- Horizon dashboard (/horizon). Basic auth, required outside local env ---
HORIZON_BASIC_AUTH_USER=
HORIZON_BASIC_AUTH_PASSWORD=

# --- Mail (mailpit in dev: UI at http://localhost:8025) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="alerts@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Dev tunnel (read by the tunnel-named container). Empty = random trycloudflare.com URL. ---
TUNNEL_TOKEN=

# --- Support contact shown on /support and /privacy ---
SUPPORT_EMAIL=support@example.com
