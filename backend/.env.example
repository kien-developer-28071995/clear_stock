APP_NAME="Clear Stock"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public HTTPS URL (tunnel in dev). `make tunnel` rewrites this (and frontend/.env) automatically.
APP_URL=https://example.trycloudflare.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logs go to stdout/stderr (docker compose logs)
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Shopify (Dev Dashboard > your app > Settings) ---
SHOPIFY_APP_NAME="Clear Stock"
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_inventory,read_locations,read_orders,read_all_orders,read_merchant_managed_fulfillment_orders,read_third_party_fulfillment_orders
SHOPIFY_API_VERSION=2026-07
# Billing API: test charges (no real money). MUST be false in production.
SHOPIFY_BILLING_TEST=true
SHOPIFY_BILLING_TRIAL_DAYS=7

# --- Database (service "mysql" in docker compose) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=secret
# Used only by the mysql container (it reads this file too)
DB_ROOT_PASSWORD=root

# --- Redis (cache + queue + Horizon) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=app_cache_

# --- Horizon dashboard (/horizon). Basic auth, required outside local env ---
HORIZON_BASIC_AUTH_USER=
HORIZON_BASIC_AUTH_PASSWORD=

# --- Mail (mailpit in dev: UI at http://localhost:8025) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="alerts@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Real-time stock alerts (Growth) batch changes for this many minutes into one email. Lower it to try them in dev.
ALERTS_REALTIME_BATCH_MINUTES=15

# --- Dev tunnel (read by the tunnel-named container). Empty = random trycloudflare.com URL. ---
TUNNEL_TOKEN=

# --- Support contact (the website shows it on /support and /privacy: build it with the same value) ---
SUPPORT_EMAIL=support@example.com

# --- Marketing website (website/): the app's /privacy and /support redirect here. Not APP_URL. ---
WEBSITE_URL=http://localhost:4321

# Error monitoring: errors (unhandled exceptions, failed jobs, caught system errors,
# frontend crashes) are posted to one Slack channel via an incoming webhook.
# Create one at https://api.slack.com/apps -> Incoming Webhooks. Empty = off.
MONITORING_SLACK_WEBHOOK_URL=
# error (default) | warning (also handled/expected problems) | critical
MONITORING_SLACK_LEVEL=error
# Business events (install, uninstall, upgrade, downgrade) go to a separate channel. Empty = off.
MONITORING_SLACK_EVENTS_WEBHOOK_URL=
# The same error is posted at most once per window (seconds)
MONITORING_THROTTLE_SECONDS=600
# Label shown in every alert (defaults to APP_ENV)
MONITORING_ENVIRONMENT=

# Email log (email_logs table: every email sent, metadata only) kept for this many days
EMAIL_LOG_RETENTION_DAYS=180

# Feature switches (config/features.php, all on in development). See README "Feature switches".
# FEATURE_WHAT_IF=true
# FEATURE_REFERENCE_PRODUCTS=true
# FEATURE_ABC=true
# FEATURE_PURCHASE_PLAN=true
# FEATURE_SPIKE_FILTER=true
# FEATURE_LOST_SALES=true
# FEATURE_ACCURACY=true
# FEATURE_SALES_EVENTS=true
# FEATURE_ORDER_BUDGET=true
# FEATURE_WEEKLY_SUMMARY=true
# FEATURE_PURCHASE_ORDERS=true
# FEATURE_SUPPLIER_EMAILS=true
# FEATURE_LOCATIONS=true
# FEATURE_TRANSFERS=true
# FEATURE_REALTIME_ALERTS=true
# FEATURE_FLOW_TRIGGERS=true
# BILLING_GROWTH_OFFERED=true
