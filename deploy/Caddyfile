# HTTPS in front of three separate things (Let's Encrypt certificates, automatic renewal):
#   api.example.com  the backend: API, webhooks, Horizon (the "web" container)   = APP_URL
#   app.example.com  the app's frontend: a static site (frontend/)               = FRONTEND_URL
#   www.example.com  the marketing website (website/)                            = WEBSITE_URL
# Install Caddy on the server, copy this to /etc/caddy/Caddyfile, replace the domains, then:
#   sudo systemctl reload caddy
# The web container listens on 127.0.0.1:8080 (APP_PORT in the deploy dir's .env).
api.example.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8080
}

# The app's frontend (frontend/): static files the Deploy workflow uploads to <deploy dir>/frontend.
# Shopify opens it in the admin iframe as /?shop=...&host=...; it calls the API at api.example.com.
# When the frontend moves to its own server, this block (and only this block) moves with it.
app.example.com {
    encode zstd gzip
    root * /opt/clear_stock/frontend

    # Iframe protection, required for embedded apps: only the shop's own admin may frame the app,
    # and a request without a valid shop may not be framed at all.
    @shop expression `{query.shop}.matches('^[a-zA-Z0-9][a-zA-Z0-9-]*[.]myshopify[.]com$')`
    @noShop not expression `{query.shop}.matches('^[a-zA-Z0-9][a-zA-Z0-9-]*[.]myshopify[.]com$')`
    header @shop Content-Security-Policy "frame-ancestors https://{query.shop} https://admin.shopify.com;"
    header @noShop Content-Security-Policy "frame-ancestors 'none';"

    # Hashed assets never change; the page itself is always re-checked so a deploy shows at once.
    header /assets/* Cache-Control "public, max-age=31536000, immutable"
    @page not path /assets/*
    header @page Cache-Control "no-cache"

    # Client-side routes (/products/12, /settings...) are all the same page.
    try_files {path} /index.html
    file_server
}

# Owner reports (admin/), only if you want them on a domain instead of an SSH tunnel
# (ssh -L 8090:127.0.0.1:8090 user@server, then http://localhost:8090). Set REPORT_ALLOWED_IPS in
# admin/.env first, and let Caddy refuse every other address as well:
# admin.example.com {
#     @denied not remote_ip 203.0.113.7
#     respond @denied 404
#     reverse_proxy 127.0.0.1:8090
# }

# Marketing website (website/): static files the Deploy workflow uploads to <deploy dir>/website.
# Pages are built as privacy.html, vi/support.html...: try_files serves them at /privacy, /vi/support.
www.example.com {
    encode zstd gzip
    root * /opt/clear_stock/website
    try_files {path} {path}.html {path}/index.html
    file_server
    handle_errors {
        @notFound expression {err.status_code} == 404
        handle @notFound {
            rewrite * /404.html
            file_server
        }
    }
    header /_astro/* Cache-Control "public, max-age=31536000, immutable"
    header /screenshots/* Cache-Control "public, max-age=86400"
}
