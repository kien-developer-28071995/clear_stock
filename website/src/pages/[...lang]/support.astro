---
import Support from '../../components/Support.astro';
import Base from '../../layouts/Base.astro';
import { site } from '../../config';
import { localeFromParam, localeStaticPaths, translator } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = localeFromParam(Astro.params.lang);
const { t } = translator(locale);
---

<Base locale={locale} page="support" title={`${t('legal.support.title')} · ${site.appName}`} description={`${t('legal.support.contact', { app: site.appName })} ${site.supportEmail}`.trim()}>
    <Support locale={locale} />
</Base>
