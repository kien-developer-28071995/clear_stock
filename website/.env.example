# Website build settings (read at build time; the site is static HTML).
# Public URL of this site, without a trailing slash (canonical links, sitemap).
SITE_URL=http://localhost:4321
# Name shown to merchants: keep equal to SHOPIFY_APP_NAME in app/backend/.env.
APP_NAME="Clear Stock"
# Shown on /support and /privacy: keep equal to SUPPORT_EMAIL in app/backend/.env.
SUPPORT_EMAIL=support@example.com
# "Install" buttons: the App Store listing once published (https://apps.shopify.com/<handle>).
# Empty = the app is not listed yet: no Install button anywhere, "coming soon" under the headline.
INSTALL_URL=
# Show the Growth plan on the pricing section (BILLING_GROWTH_OFFERED in app/backend/.env).
GROWTH_OFFERED=false
# Crisp live chat: the Website ID from crisp.chat (Settings → Workspace Settings → Setup & Integrations).
# Empty = no chat widget. Setting it also adds the Crisp sentence to /privacy.
CRISP_WEBSITE_ID=
