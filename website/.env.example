# Website build settings (read at build time; the site is static HTML).
# Public URL of this site, without a trailing slash (canonical links, sitemap).
SITE_URL=http://localhost:4321
# Name shown to merchants: keep equal to SHOPIFY_APP_NAME in backend/.env.
APP_NAME="Clear Stock"
# Shown on /support and /privacy: keep equal to SUPPORT_EMAIL in backend/.env.
SUPPORT_EMAIL=support@example.com
# "Install" buttons: the App Store listing once published (https://apps.shopify.com/<handle>).
INSTALL_URL=https://apps.shopify.com/
# Show the Growth plan on the pricing section (BILLING_GROWTH_OFFERED in backend/.env).
GROWTH_OFFERED=false
